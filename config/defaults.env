# Non-interactive settings. The installer still asks only for domain and key.
# Set one or several panel addresses before installation (required):
# PANEL_IPS=203.0.113.10,2001:db8::10
PANEL_IPS=
# Optional: xray (direct Reality/XTLS on :443, default) or nginx-ws (TLS termination + WebSocket proxy).
# TLS_MODE=nginx-ws
# WS_PROXY_PORT=10000
